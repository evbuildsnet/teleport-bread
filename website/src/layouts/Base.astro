      posthog.init("phc_r22AzZ8Ute7cxdhNumnvZDd3VZkvYV2qkMSj9YFQYwnU", {
        api_host: "https://us.i.posthog.com",
        defaults: "2025-05-24",
      });
    </script>
  </head>
  <body>
    <slot />
    <footer>
      <a href="/">Teleport Bread</a>
      <a href="/privacy">Privacy</a>
      <a href="https://github.com/evbuildsnet/teleport-bread">Source</a>
      <a href="mailto:help@evbuilds.net">help@evbuilds.net</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fcfcfc;
    --text: #27272a;
    --muted: #71717b;
    --accent: #1b4ed8;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0a0a0a;
      --text: #f5f5f5;
      --muted: #a3a3a3;
      --accent: #346bf1;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    align-items: center;
    padding: 0 20px;
  }
  footer {
    margin-top: auto;
    padding: 40px 0 32px;
    display: flex;
    gap: 24px;
    font-size: 14px;
  }
  footer a {
    color: var(--muted);
    text-decoration: none;
  }
  footer a:hover {
    color: var(--text);
  }
</style>
